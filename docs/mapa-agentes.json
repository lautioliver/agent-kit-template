{
  "_ayuda": "Mapa para agentes y CI. 'docs': qué documento revisar cuando cambian ciertos archivos (lo usan update-docs, implement-issue y review-pr). 'sensibles': rutas que exigen consultar antes de cambiarlas y correr /security-review (ver AGENTS.md, Autonomía). 'verificar': qué correr antes del PR según lo que cambió (scripts/agentes/verificar.py). 'obligatorios': documentos que tienen que existir (lo valida scripts/agentes/check-docs.py). 'ignorar_check': rutas que check-docs.py no valida, como bitácoras históricas que citan archivos que ya no existen. Globs estilo git: ** cualquier profundidad, * un nivel. Una ruta que empieza con ? es opcional: check-docs no falla si no coincide con ningún archivo (sirve para alternativas de stack, como package.json o *.lock). Las rutas propias del proyecto van sin ?: si dejan de existir, el check falla. TODO: completar con las rutas del proyecto.",
  "docs": [
    {
      "cuando": [
        "TODO/schema/**",
        "?**/migrations/**"
      ],
      "revisar": [
        "docs/reference/domain.md",
        "docs/development/architecture.md"
      ],
      "motivo": "cambió el modelo de datos"
    },
    {
      "cuando": [
        "TODO/api/routes/**"
      ],
      "revisar": [
        "docs/development/architecture.md",
        "docs/reference/surfaces.md"
      ],
      "motivo": "cambió un endpoint o una pantalla"
    },
    {
      "cuando": [
        "TODO/modules/**"
      ],
      "revisar": [
        "docs/reference/modules.md"
      ],
      "motivo": "cambió la responsabilidad de un módulo"
    },
    {
      "cuando": [
        "?package.json",
        "?**/package.json",
        "?.github/workflows/**"
      ],
      "revisar": [
        "AGENTS.md",
        "docs/development/setup.md"
      ],
      "motivo": "cambió un comando, una dependencia o el CI"
    },
    {
      "cuando": [
        "?infra/**",
        "?Dockerfile",
        "?**/*.toml"
      ],
      "revisar": [
        "docs/development/deploy.md"
      ],
      "motivo": "cambió la infraestructura o el deploy"
    },
    {
      "cuando": [
        ".claude/agents/**",
        "docs/agentes/contrato-subagentes.md"
      ],
      "revisar": [
        "AGENTS.md",
        "README.md",
        "docs/agentes/contrato-subagentes.md"
      ],
      "motivo": "cambió un subagente (modelo, herramientas, escalado) o su contrato"
    }
  ],
  "sensibles": [
    {
      "tipo": "schema",
      "rutas": [
        "TODO/schema/**",
        "?**/migrations/**"
      ],
      "skill": "db-migration"
    },
    {
      "tipo": "auth",
      "rutas": [
        "TODO/auth/**",
        "?**/middleware/**"
      ]
    },
    {
      "tipo": "dinero",
      "rutas": [
        "TODO/payments/**"
      ]
    },
    {
      "tipo": "dependencias",
      "rutas": [
        "?package.json",
        "?**/package.json",
        "?*.lock",
        "?pnpm-lock.yaml"
      ]
    },
    {
      "tipo": "infra",
      "rutas": [
        "?infra/**",
        "?.github/workflows/**",
        "?Dockerfile"
      ]
    },
    {
      "tipo": "api-publica",
      "rutas": [
        "TODO/public-api/**"
      ]
    }
  ],
  "verificar": [
    {
      "nombre": "docs",
      "siempre": true,
      "correr": "python3 scripts/agentes/check-docs.py"
    },
    {
      "nombre": "shellcheck",
      "cuando": [
        "**/*.sh"
      ],
      "correr": "command -v shellcheck >/dev/null || { echo 'Falta shellcheck: brew install shellcheck (macOS) o apt install shellcheck. Sin él, esta verificación no corre.'; exit 1; }; shellcheck {archivos}"
    },
    {
      "nombre": "preparar",
      "cuando": [
        ".claude/skills/implement-issue/preparar.sh",
        ".claude/skills/implement-issue/test-preparar.sh"
      ],
      "correr": "bash .claude/skills/implement-issue/test-preparar.sh"
    },
    {
      "nombre": "agentes",
      "cuando": [
        ".claude/agents/**",
        "docs/agentes/contrato-subagentes.md",
        "scripts/agentes/check-docs.py",
        "scripts/agentes/test-agentes.sh"
      ],
      "correr": "bash scripts/agentes/test-agentes.sh"
    },
    {
      "nombre": "rojo",
      "cuando": [
        ".claude/skills/implement-issue/rojo.sh",
        ".claude/skills/implement-issue/test-rojo.sh"
      ],
      "correr": "bash .claude/skills/implement-issue/test-rojo.sh"
    },
    {
      "nombre": "orquestar",
      "cuando": [
        ".claude/skills/orquestar/**",
        ".claude/agents/revisor.md"
      ],
      "correr": "bash .claude/skills/orquestar/test-orquestar.sh"
    },
    {
      "nombre": "retros",
      "cuando": [
        ".claude/skills/mejorar-skills/**"
      ],
      "correr": "bash .claude/skills/mejorar-skills/test-retros.sh"
    },
    {
      "nombre": "base",
      "cuando": [
        "scripts/agentes/**"
      ],
      "correr": "bash scripts/agentes/test-base.sh"
    },
    {
      "nombre": "init",
      "cuando": [
        "?scripts/init-plantilla.sh",
        "?scripts/test-init.sh"
      ],
      "correr": "bash scripts/test-init.sh"
    },
    {
      "nombre": "lint",
      "siempre": true,
      "correr": "TODO: comando de lint (por ejemplo: npm run lint)"
    },
    {
      "nombre": "typecheck",
      "siempre": true,
      "correr": "TODO: comando de typecheck (por ejemplo: npx tsc --noEmit)"
    },
    {
      "nombre": "tests",
      "siempre": true,
      "correr": "TODO: tests, idealmente solo los afectados (por ejemplo: npx vitest related {archivos} --run)"
    },
    {
      "nombre": "migraciones",
      "cuando": [
        "TODO/schema/**",
        "?**/migrations/**"
      ],
      "correr": "TODO: verificar que el schema y las migraciones coinciden (generar y comprobar que no queda nada sin commitear)"
    },
    {
      "nombre": "contrato-api",
      "cuando": [
        "TODO/public-api/**"
      ],
      "correr": "TODO: comparar el contrato público contra la base (por ejemplo: un diff de OpenAPI)"
    }
  ],
  "obligatorios": [
    "AGENTS.md",
    "docs/README.md",
    "docs/llms.txt",
    "docs/convencion-nombres-github.md",
    "docs/decisions/README.md",
    "docs/development/architecture.md"
  ],
  "ignorar_check": [
    "perfiles/**"
  ]
}
