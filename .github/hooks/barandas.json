{
  "version": 1,
  "hooks": {
    "preToolUse": [
      {
        "type": "command",
        "matcher": "bash",
        "bash": "f=\"$(git rev-parse --show-toplevel 2>/dev/null)/scripts/agentes/barandas.py\"; [ -f \"$f\" ] || exit 0; exec python3 \"$f\"",
        "timeoutSec": 15
      }
    ]
  }
}
